* text=auto eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.bit binary
*.ltx binary
*.xsa binary
*.elf binary

# Preserve byte-exact, content-addressed/vendor-generated P7 artifacts. Their
# embedded spacing is provenance data and must not be rewritten to satisfy a
# source whitespace policy.
evidence/generated/vitis/p7_ps_runtime/* -text -whitespace
evidence/generated/p7_* -text -whitespace
evidence/generated/p7_r34_failure_package/** -text -whitespace
evidence/hardware/p7/artifacts/* -text -whitespace
evidence/hardware/p7/** -text -whitespace
