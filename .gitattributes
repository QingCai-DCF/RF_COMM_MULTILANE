# Preserve byte-exact, content-addressed P9 artifacts and generated/hardware
# evidence.  Raw Vivado/XSDB outputs commonly contain CRLF and trailing vendor
# formatting that are covered by immutable SHA256 manifests.
artifacts/p9/** -text -whitespace
evidence/hardware/p9/** -text -whitespace
evidence/hardware/p9_diagnostics/** -text -whitespace
evidence/generated/p9_* -text -whitespace
evidence/generated/p9_*/** -text -whitespace
evidence/generated/vivado/p9_*/** -text -whitespace
evidence/generated/vitis/p9_*/** -text -whitespace

# Recovered/formal P8D raw Vivado and XSim records are also immutable evidence;
# retain vendor spacing and original line endings in the P9 evidence checkpoint.
evidence/generated/p8d_raw/** -text -whitespace

# Preserve byte-exact P10 content-addressed binary/tool artifacts.
artifacts/p10/** -text -whitespace
evidence/generated/vivado/p10_*/** -text -whitespace
evidence/hardware/p10/** -text -whitespace

# Preserve byte-exact P10.1 generated summaries, raw tool logs, and software
# artifacts. Vendor logs contain significant trailing spacing and are bound by
# SHA256 records, so source whitespace normalization must not rewrite them.
artifacts/p10_1/** -text -whitespace
evidence/hardware/p10_1/** -text -whitespace
evidence/generated/p10_1_* -text -whitespace
evidence/generated/p10_1_*/** -text -whitespace

# Preserve the LED follow-up's content-addressed deliverables and byte-exact
# Vivado/Vitis reports.  Vendor output spacing is provenance covered by SHA256.
artifacts/p10_1_led/** -text -whitespace
evidence/generated/vivado/p10_1_ax7020_pl_activity_led/** -text -whitespace
evidence/generated/vitis/p10_1_ax7020_pl_activity_led_runtime/** -text -whitespace

# Preserve byte-exact P10.1R content-addressed artifacts, generated summaries,
# raw XSim/Vivado/Vitis output, and captured offline regression evidence. These
# files are covered by SHA256 manifests and must not undergo EOL normalization.
artifacts/p10_1r/** -text -eol -whitespace
evidence/hardware/p10_1r/** -text -eol -whitespace
evidence/generated/p10_1r_* -text -eol -whitespace
evidence/generated/p10_1r_*/** -text -eol -whitespace
evidence/generated/vivado/p10_1r/** -text -eol -whitespace
evidence/generated/vivado/p10_1r_shutdown/** -text -eol -whitespace
evidence/generated/vitis/p10_1r_runtime/** -text -eol -whitespace

# Preserve byte-exact P10.2 content-addressed artifacts and referenced vendor
# outputs. Their original spacing and line endings are covered by SHA256.
artifacts/p10_2/** -text -eol -whitespace
evidence/generated/p10_2_raw/**/*.log -text -eol -whitespace
evidence/generated/p10_2_software/** -text -eol -whitespace
evidence/generated/vivado/p10_2_4lane/** -text -eol -whitespace
evidence/generated/vitis/p10_2_4lane_runtime/** -text -eol -whitespace

# Preserve the byte-exact bounded P10.3 raw-connectivity run.  Its immutable
# evidence manifest covers vendor CRLF output and raw PSV/TCL records.
evidence/hardware/p10_3_raw_connectivity/** -text -eol -whitespace

# Preserve byte-exact P10.3 campaign evidence, including vendor CRLF output
# and raw PSV/TCL records covered by each run's SHA256 manifest.
evidence/hardware/p10_3/** -text -eol -whitespace

# Preserve the P10.3F content-addressed bundle and byte-exact offline evidence.
# Simulator and vendor logs are SHA256-bound and retain their original spacing.
artifacts/p10_3_fault_forensics/** -text -eol -whitespace
evidence/generated/p10_3_fault_forensics_* -text -eol -whitespace
evidence/generated/p10_3_fault_forensics_*/** -text -eol -whitespace
evidence/generated/vivado/p10_3_fault_forensics*/** -text -eol -whitespace
evidence/generated/vitis/p10_3_fault_forensics_runtime/** -text -eol -whitespace

# Preserve byte-exact P10.3F full-campaign hardware evidence.  Each run's
# manifest binds raw XSDB/PSV/TCL data, including vendor whitespace and CRLF.
evidence/hardware/p10_3f_full/** -text -eol -whitespace

# Preserve byte-exact P10.4 content-addressed artifacts, offline build output,
# and hardware evidence.  Run manifests bind vendor CRLF/trailing whitespace,
# so Git must not normalize those bytes during checkpoint creation.
artifacts/p10_4/** -text -eol -whitespace
evidence/hardware/p10_4/** -text -eol -whitespace
evidence/generated/p10_4_* -text -eol -whitespace
evidence/generated/p10_4_*/** -text -eol -whitespace
evidence/generated/vivado/p10_4_*/** -text -eol -whitespace
evidence/generated/vitis/p10_4_*/** -text -eol -whitespace
