+        P7_FIRST_ERROR_DIAGNOSTIC_TOTAL_BYTES, magic_readback);
+  }
+  return p7_publish_failure_snapshot_diagnostic(
+      mailbox, P7_FAILURE_SNAPSHOT_STATUS_PUBLISHED, address,
+      P7_FIRST_ERROR_DIAGNOSTIC_TOTAL_BYTES, magic_readback);
+}
