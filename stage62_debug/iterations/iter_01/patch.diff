+static uint32_t p7_first_snapshot_mismatch(
+    const volatile uint8_t *left, const volatile uint8_t *right,
+    uint32_t size) {
+  for (uint32_t index = 0U; index < size; ++index) {
+    if (left[index] != right[index]) return index;
+  }
+  return UINT32_MAX;
+}
