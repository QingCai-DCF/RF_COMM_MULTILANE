# P8E implementation work products are content-addressed in the accepted raw
# artifact manifest.  Retain reports and logs, but do not version Vivado/XSim
# scratch projects, generated simulation netlists, or iterative development
# runs.
/evidence/generated/p8e_raw/development/
/evidence/generated/p8e_raw/**/project/
/evidence/generated/p8e_raw/**/work/
/evidence/generated/p8e_raw/**/post_synth_funcsim.v

