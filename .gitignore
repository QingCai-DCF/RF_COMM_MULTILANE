# Ephemeral P7 Stage66 preparation/runtime state. Immutable snapshots are
# committed separately after each terminal outcome; never ignore the lock.
/evidence/generated/p7_stage66_campaign_next_preparation/
/evidence/hardware/p7/stage66_diagnostic_campaign/p7_stage66_stationary_diagnostic_20260715/campaign_ledger.json

# P8D iterative probes and local compile products.  Formal run directories are
# intentionally not ignored because accepted and failed evidence is immutable.
/evidence/generated/p8d_raw/quick_*/
/evidence/generated/p8d_raw/reference_probe/
/evidence/generated/p8d_raw/reference_quick/
/evidence/generated/p8d_raw/resource_dev_*/
