+        self.assertEqual(words[2:6], (3, 31, 2, 3))
+        self.assertEqual(words[7], zlib.crc32(control[:28]) & 0xFFFFFFFF)
+        self.assertEqual(words[8], 1)
+        self.assertEqual(words[14:16], (1, 0))
